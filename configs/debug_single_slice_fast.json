{
  "input": {
    "folder": "C:/Users/jediati/Desktop/JEDIATI/data/spears",
    "extensions": [".tif", ".tiff"],
    "match": "recon_",
    "use_regex": false,
    "natural_sort": true,
    "start": 0,
    "count": 6,
    "stride": 1
  },
  "output": {
    "folder": "C:/Users/jediati/Desktop/JEDIATI/data/spears/mscoupon_debug_out_fast",
    "mask_template": "{stem}_mask.tiff",
    "table_template": "{stem}_segments.csv",
    "overwrite": true
  },
  "filter": {
    "operation": "edges",
    "params": {
      "sigma": 2.0,
      "output": "magnitude"
    }
  },
  "msc": {
    "persistence_absolute": null,
    "persistence_percent": 20.0,
    "accurate_ascending": false,
    "accurate_descending": false,
    "manifold": "ascending"
  },
  "segments": {
    "min_area": null,
    "max_area": 1000000,
    "min_value": null,
    "max_value": null,
    "min_mean": null,
    "max_mean": 0.0006,
    "allow_ids": [],
    "deny_ids": []
  },
  "execution": {
    "total_threads": 16,
    "threads_per_slice": 4,
    "concurrent_slices": 4,
    "read_threads": 1,
    "write_threads": 1,
    "max_slices_at_a_time": 3,
    "read_queue_capacity": 1,
    "write_queue_capacity": 1
  },
  "timing": {
    "write_json": true,
    "write_csv": true,
    "output_path": "C:/Users/jediati/Desktop/JEDIATI/data/spears/mscoupon_debug_out_fast/timing_report.json"
  }
}
